{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source scraping cubestore metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Cube Store HA fork — raft cluster health. Operator-facing dashboard for the cs.raft.* metrics shipped in M9.1. Build a 3-router cluster, set CUBESTORE_HA_MODE=raft, and point Prometheus at the cubestore /metrics endpoint to populate this.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Which pod is currently leader. Stable in healthy clusters; rapid changes indicate flapping (split-brain risk on the network layer).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cs_raft_is_leader{job=\"cubestore\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Leader (1=this pod is leader)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Current raft term across all pods. Stable in healthy clusters. Rising rapidly = election storm (split vote, network blips, or tick budget set too tight).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "term",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "spanNulls": false
          }
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cs_raft_term{job=\"cubestore\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Raft term (per replica)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Leader-changes counter. A few per day during rolling restarts is normal. Sustained > 1/min = problem (flaky network, OOM, GC stalls).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 60 }
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(cs_raft_leader_changes{job=\"cubestore\"}[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Leader changes / sec (5m rate)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Commit index vs applied index. They should track each other within ~1 entry. A widening gap means the apply path is backed up — RocksDB compaction, slow MetaStore writes, or a stuck Apply impl.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cs_raft_commit_index{job=\"cubestore\"}",
          "legendFormat": "commit {{instance}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cs_raft_applied_index{job=\"cubestore\"}",
          "legendFormat": "applied {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Commit vs applied index",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Apply latency per committed entry on each replica. Tail (p99) here is the dominant contributor to write commit latency on a healthy cluster.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum(rate(cs_raft_apply_duration_ms_bucket{job=\"cubestore\"}[5m])) by (le, instance))",
          "legendFormat": "p99 {{instance}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum(rate(cs_raft_apply_duration_ms_bucket{job=\"cubestore\"}[5m])) by (le, instance))",
          "legendFormat": "p50 {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Apply duration (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Successful vs failed proposes. Failed = ProposalDropped (no leader during election) or encode failures. A few failures during leader changeover are normal; sustained failures = no quorum forming.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(cs_raft_proposals_success{job=\"cubestore\"}[1m])",
          "legendFormat": "success {{instance}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(cs_raft_proposals_failed{job=\"cubestore\"}[1m])",
          "legendFormat": "failed {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Proposes / sec (1m rate)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Replica-local view of who is leader (raft-rs's leader_id field). All replicas should agree within ~50ms (one raft tick). Disagreement for >1s indicates a partition or stuck heartbeat path.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "leader_id",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "cs_raft_leader_id{job=\"cubestore\"}",
          "legendFormat": "{{instance}} sees leader=",
          "refId": "A"
        }
      ],
      "title": "Per-replica leader_id (0 = no leader known)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cubestore", "ha", "raft"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Cube Store HA — Raft cluster",
  "uid": "cubestore-ha-raft",
  "version": 1,
  "weekStart": ""
}
